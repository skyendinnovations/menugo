{
  "name": "menugo",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "turbo dev",
    "start": "turbo start",
    "dev:backend": "turbo dev --filter=backend",
    "dev:mobile": "turbo dev --filter=mobile",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "turbo format",
    "db:generate": "bun run --cwd packages/data generate",
    "db:migrate": "bun run --cwd packages/data migrate",
    "db:migrate:up": "bun run --cwd packages/data migrate:up",
    "db:migrate:down": "bun run --cwd packages/data migrate:down",
    "db:migrate:status": "bun run --cwd packages/data migrate:status",
    "db:studio": "bun run --cwd packages/data studio",
    "db:push": "bun run --cwd packages/data push",
    "db:seed:plans": "bun run packages/data/src/seeds/subscription-plans.seed.ts"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "bun@1.2.5"
}
