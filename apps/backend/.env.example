DATABASE_URL=
PORT=5000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

TRUSTED_ORIGINS=menugo://,http://localhost:8081,https://yourdomain.com


CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Cloudflare R2 Storage
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=

# Firebase Cloud Messaging (for push notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Web Client Config (public keys, served to service worker via /api/config/firebase)
FIREBASE_WEB_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=

# Email (for magic links, verification, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@menugo.com


SKYEND_URL=
SKYEND_API_KEY=
SKYEND_CALLBACK_URL=