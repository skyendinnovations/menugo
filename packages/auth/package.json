{
  "name": "@menugo/auth",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" && prettier -c \"src/**/*.ts\"",
    "format": "eslint \"src/**/*.ts\" --fix && prettier \"src/**/*.ts\" --write",
    "clean": "rm -rf node_modules .turbo"
  },
  "peerDependencies": {
    "better-auth": "*",
    "@better-auth/expo": "*",
    "expo-secure-store": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react-native": "*",
    "expo-secure-store": "*",
    "react-native": "*",
    "typescript": "^5.9.3"
  }
}
