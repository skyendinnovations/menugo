{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "jest --runInBand",
    "start": "bun run index.ts",
    "dev": "bun run --watch index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" && prettier -c \"src/**/*.ts\"",
    "format": "eslint \"src/**/*.ts\" --fix && prettier \"src/**/*.ts\" --write",
    "migrate": "drizzle-kit migrate",
    "migrate:up": "drizzle-kit migrate up",
    "migrate:down": "drizzle-kit migrate down",
    "migrate:status": "drizzle-kit migrate status",
    "generate": "drizzle-kit generate",
    "studio": "drizzle-kit studio",
    "push": "drizzle-kit push"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/nodemailer": "^6.4.17",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "typescript-eslint": "^8.55.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@better-auth/expo": "^1.4.10",
    "@menugo/auth": "workspace:*",
    "@menugo/data": "workspace:*",
    "@menugo/dto": "workspace:*",
    "@menugo/email": "workspace:*",
    "@menugo/storage": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "better-auth": "^1.4.10",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "firebase-admin": "^13.6.1",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "sonare": "^0.0.1",
    "zod": "^4.3.6"
  }
}